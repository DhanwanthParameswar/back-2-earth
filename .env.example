# Copy to .env (gitignored) and fill in. Never commit .env.
# Used by tools/deploy_web.sh.

# SSH login for the web server, e.g. ubuntu@<server ip>
DEPLOY_SERVER=
# Path to your private SSH key for that server, e.g. ~/.ssh/<key file>
DEPLOY_SSH_KEY=
# Optional: path to the Godot 4.7.2 console executable
GODOT=

# API keys (Gemini, ElevenLabs, ...) do NOT go here: they live only on the
# server in /etc/back2earth/companion.env, never on laptops or in the game.
