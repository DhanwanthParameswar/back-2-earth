extends Node
## The single source of truth for a run (autoload "GameState"). Owner: A.
##
## Everything that changes the rules goes through here: objective order,
## inventory, the countdown, damage, and win/lose. Other systems ask GameState
## and listen to its signals; they never set these values directly.
## The AI companion only READS from here.

# --- Shared contract signals (see README "Contracts") ---
signal phase_changed(phase: int)
signal objective_changed(objective_id: String)  # the NEW current objective ("" when done)
signal inventory_changed
signal time_changed(seconds: int)                # whole seconds left, emitted when it ticks
signal run_ended(won: bool)
signal damaged(seconds_lost: float)
signal room_changed(room_id: String)
signal paused_changed(is_paused: bool)
## Meaningful moments for ECHO and effects. ids are listed in GAME_EVENTS.
signal game_event(event_id: String)

enum Phase { BRIEFING, PLAYING, WON, LOST }

# --- Tuning (arcade values, not physics) ---
const START_TIME := 360.0        # six-minute evacuation window
const DEBRIS_PENALTY := 10.0
const HIT_COOLDOWN := 1.0
const LOW_TIME_THRESHOLD := 60.0

## Objectives in the only order they can be completed.
## "room" is informational (HUD/companion). "hint" is the canonical hint:
## the authoritative instruction, never generated by the model.
const OBJECTIVES := [
	{
		"id": "start_evacuation", "room": "cockpit",
		"text": "Restore emergency power",
		"hint": "Use the cockpit terminal (E). Hold SPACE during a surge to brace with mag-boots.",
	},
	{
		"id": "restore_power", "room": "engineering",
		"text": "Restore main power",
		"hint": "Go right into Engineering and activate the amber power console.",
	},
	{
		"id": "open_compartment", "room": "cargo",
		"text": "Open the core compartment",
		"hint": "The cargo sled is powered. Wait for a DOWN surge to slide it onto the pressure plate.",
	},
	{
		"id": "collect_core", "room": "cargo",
		"text": "Collect the navigation core",
		"hint": "The compartment in the top-right of Cargo is open. Grab the core (E).",
	},
	{
		"id": "release_clamp", "room": "pod_bay",
		"text": "Release the pod clamp",
		"hint": "In the Pod Bay, use the clamp console at the top (E).",
	},
	{
		"id": "board_pod", "room": "pod_bay",
		"text": "Board the escape pod",
		"hint": "Get to the escape pod and press E to launch.",
	},
]

## Item granted when an objective completes.
const OBJECTIVE_REWARDS := {"collect_core": "navigation_core"}

## Event fired for ECHO when an objective completes.
const OBJECTIVE_EVENTS := {
	"start_evacuation": "evacuation_started",
	"restore_power": "power_restored",
	"open_compartment": "puzzle_solved",
	"collect_core": "core_collected",
	"release_clamp": "clamp_released",
	"board_pod": "launch",
}

const GAME_EVENTS := [
	"run_start", "evacuation_started", "power_restored", "puzzle_solved",
	"core_collected", "clamp_released", "launch", "debris_hit",
	"debris_hit_repeat", "boots_frequent", "low_time", "help",
]

var phase: int = Phase.BRIEFING
var run_id := 0
## Bumped whenever the situation changes enough that a pending companion
## reply would be stale (new run, objective change).
var state_version := 0
var time_left := START_TIME
var objective_index := 0
var inventory: Array[String] = []
var current_room := "cockpit"
var boots_use_count := 0
var hit_count := 0
var recent_event := ""

var _hit_cooldown_left := 0.0
var _last_whole_second := -1
var _low_time_sent := false
var _run_counter := 0


func _ready() -> void:
	# Pausable: the countdown stops while the tree is paused.
	process_mode = Node.PROCESS_MODE_PAUSABLE


## Start a fresh run. main.gd calls this every time the main scene loads,
## so "restart" = reload the scene.
func new_run() -> void:
	_run_counter += 1
	run_id = _run_counter * 1000 + randi() % 1000
	state_version = 0
	phase = Phase.BRIEFING
	time_left = START_TIME
	objective_index = 0
	inventory.clear()
	current_room = "cockpit"
	boots_use_count = 0
	hit_count = 0
	recent_event = ""
	_hit_cooldown_left = 0.0
	_last_whole_second = -1
	_low_time_sent = false
	if get_tree() != null:
		get_tree().paused = false
	phase_changed.emit(phase)
	objective_changed.emit(current_objective_id())
	inventory_changed.emit()
	time_changed.emit(int(ceil(time_left)))


## Leave the suit picker (BRIEFING phase) and hand control to the player.
func begin_play() -> void:
	if phase != Phase.BRIEFING:
		return
	phase = Phase.PLAYING
	phase_changed.emit(phase)
	_fire_event("run_start")


func is_playing() -> bool:
	return phase == Phase.PLAYING


## The countdown runs once the evacuation has started (the cockpit is a safe
## tutorial until then).
func is_timer_running() -> bool:
	return phase == Phase.PLAYING and objective_index >= 1


func _process(delta: float) -> void:
	if _hit_cooldown_left > 0.0:
		_hit_cooldown_left = maxf(0.0, _hit_cooldown_left - delta)
	if not is_timer_running():
		return
	_set_time(time_left - delta)


func _set_time(value: float) -> void:
	time_left = maxf(0.0, value)
	var whole := int(ceil(time_left))
	if whole != _last_whole_second:
		_last_whole_second = whole
		time_changed.emit(whole)
	if not _low_time_sent and time_left <= LOW_TIME_THRESHOLD and time_left > 0.0:
		_low_time_sent = true
		_fire_event("low_time")
	if time_left <= 0.0:
		_end_run(false)


# --- Objectives -----------------------------------------------------------

func current_objective_id() -> String:
	if objective_index >= OBJECTIVES.size():
		return ""
	return OBJECTIVES[objective_index]["id"]


func is_current_objective(objective_id: String) -> bool:
	return phase == Phase.PLAYING and current_objective_id() == objective_id


func is_objective_complete(objective_id: String) -> bool:
	var idx := _objective_position(objective_id)
	return idx >= 0 and idx < objective_index


## Canonical objective + hint for the HUD and the companion snapshot.
## Never contacts the model.
func get_canonical() -> Dictionary:
	if phase == Phase.BRIEFING:
		return {"id": "briefing", "text": "Choose your suit", "hint": "Click a suit, then LAUNCH."}
	if objective_index >= OBJECTIVES.size():
		return {"id": "done", "text": "Escape pod launched", "hint": ""}
	var o: Dictionary = OBJECTIVES[objective_index]
	return {"id": o["id"], "text": o["text"], "hint": o["hint"]}


## Contract: idempotent, rejects out-of-order completion.
## Returns true if the objective is (now or already) complete.
func complete_objective(objective_id: String) -> bool:
	var idx := _objective_position(objective_id)
	if idx < 0:
		push_warning("Unknown objective: %s" % objective_id)
		return false
	if idx < objective_index:
		return true  # already done: no duplicate progress
	if phase != Phase.PLAYING or idx != objective_index:
		return false  # out of order, or the run is over
	if objective_id == "board_pod" and not launch_requirements_met():
		return false

	objective_index += 1
	state_version += 1
	var reward: String = OBJECTIVE_REWARDS.get(objective_id, "")
	if reward != "" and not inventory.has(reward):
		inventory.append(reward)
		inventory_changed.emit()
	objective_changed.emit(current_objective_id())
	_fire_event(OBJECTIVE_EVENTS.get(objective_id, ""))
	if objective_id == "board_pod":
		_end_run(true)
	return true


## Central launch check: power restored + core collected + clamp released.
func launch_requirements_met() -> bool:
	return (
		is_objective_complete("restore_power")
		and is_objective_complete("collect_core")
		and inventory.has("navigation_core")
		and is_objective_complete("release_clamp")
	)


func has_item(item: String) -> bool:
	return inventory.has(item)


func _objective_position(objective_id: String) -> int:
	for i in OBJECTIVES.size():
		if OBJECTIVES[i]["id"] == objective_id:
			return i
	return -1


# --- Damage, boots, rooms -------------------------------------------------

## Debris contact. Returns true if a hit was applied (not on cooldown).
func apply_debris_hit() -> bool:
	if phase != Phase.PLAYING or _hit_cooldown_left > 0.0:
		return false
	_hit_cooldown_left = HIT_COOLDOWN
	hit_count += 1
	damaged.emit(DEBRIS_PENALTY)
	_fire_event("debris_hit")
	if hit_count % 2 == 0:
		_fire_event("debris_hit_repeat")
	if is_timer_running():
		_set_time(time_left - DEBRIS_PENALTY)
	return true


## Called by the player each time the boots are engaged (key pressed).
func note_boots_engaged() -> void:
	if phase != Phase.PLAYING:
		return
	boots_use_count += 1
	if boots_use_count == 6 or boots_use_count == 14:
		_fire_event("boots_frequent")


func set_room(room_id: String) -> void:
	if room_id == "" or room_id == current_room:
		return
	current_room = room_id
	room_changed.emit(room_id)


## Coarse time band for the companion (exact seconds would be stale on arrival).
func time_band() -> String:
	if not is_timer_running() and objective_index == 0:
		return "not_started"
	if time_left > 180.0:
		return "plenty"
	if time_left > 90.0:
		return "ok"
	if time_left > 30.0:
		return "low"
	return "critical"


# --- Pause and end of run ---------------------------------------------------

func set_paused(value: bool) -> void:
	if value and phase != Phase.PLAYING:
		return
	if get_tree().paused == value:
		return
	get_tree().paused = value
	paused_changed.emit(value)


func is_paused() -> bool:
	return get_tree().paused


func _end_run(won: bool) -> void:
	if phase != Phase.PLAYING:
		return  # success and failure can never both trigger
	phase = Phase.WON if won else Phase.LOST
	state_version += 1
	phase_changed.emit(phase)
	run_ended.emit(won)


func _fire_event(event_id: String) -> void:
	if event_id == "":
		return
	recent_event = event_id
	game_event.emit(event_id)


## Request ECHO help (H). Kept here so the companion stays read-only.
func request_help() -> void:
	if phase == Phase.PLAYING:
		_fire_event("help")
